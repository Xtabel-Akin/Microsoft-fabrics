table gold_fact_claims
	lineageTag: f9f1e3f7-5aea-4e2b-85b2-3b46ae0f1851
	sourceLineageTag: [dbo].[gold_fact_claims]

	measure 'Earned Premium' =
			
			CALCULATE(
			    SUM(gold_fact_premium_monthly[earned_premium]),
			    USERELATIONSHIP(gold_fact_premium_monthly[customer_id], gold_dim_customer[customer_id])
			)
		lineageTag: 2b019253-fab8-4e44-86e6-30d09ead6e60

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Claim Count' = COUNTROWS(gold_fact_claims)
		formatString: 0
		lineageTag: fe0c9bfb-9e34-4476-87ce-8f31929b13f1

		changedProperty = Name

	measure 'Avg Report Lag (days)' = AVERAGE(gold_fact_claims[report_lag_days])
		lineageTag: a09a7879-f970-457e-8a50-ec0d86ceb602

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Severity' = DIVIDE([Incurred], [Claim Count])
		lineageTag: 9a24809d-b2ef-4a9b-bcdb-1a4bc06b64cb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

